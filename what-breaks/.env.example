# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ACCESS_CODE: Shared access code required to start PR verification runs.
ACCESS_CODE=

# PORT: HTTP server port (defaults to 3000).
PORT=3000

# Verification & scoring thresholds and caps
RISK_THRESHOLD=0.45
JUDGE_MIN_CONFIDENCE=0.7
MAX_CONCURRENT_VERIFIERS=6
MAX_VERIFIERS_PER_RUN=10
VERIFIER_TIMEOUT_MS=240000
RUN_TIMEOUT_MS=600000
MAX_DIFF_TOKENS=200000

# Set RECORD=1 to save real runs into data/recordings/ for replay
RECORD=0
